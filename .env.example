# Copy to .env for local development (never commit .env).
# On Railway, set these in the app service's Variables tab instead.

# Database — Railway's MySQL service exposes exactly these names;
# reference them from the app service, e.g. MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=lazyledger

# production | development (development shows error details in API responses)
APP_ENV=development

# Initial accounts created on first boot when the users table is empty.
# If a password is left blank, that account is not seeded.
SEED_ADMIN_EMAIL=admin@lazyledger.test
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@lazyledger.test
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_EMAIL=demo@lazyledger.test
SEED_CUSTOMER_PASSWORD=

# Email (Brevo). Without BREVO_API_KEY, emails are skipped and logged instead.
BREVO_API_KEY=
# Must be a sender verified in Brevo. Prefer an address on a domain you own:
# Gmail addresses sent through Brevo often fail DMARC and land in spam.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LazyLedger Support
# Public URL used for buttons in emails (on Railway, RAILWAY_PUBLIC_DOMAIN is used when this is empty).
APP_URL=
